rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS (P0 Security Rules)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isTdtuUser() {
      return isAuthenticated() && 
        (request.auth.token.email.matches('.*@tdtu\\.edu\\.vn$') || 
         request.auth.token.email.matches('.*@student\\.tdtu\\.edu\\.vn$'));
    }

    function isLecturer() {
      return isAuthenticated() && request.auth.token.email.matches('.*@tdtu\\.edu\\.vn$');
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // 1. Hồ sơ người dùng hệ thống
    match /tdtu_users/{userId} {
      allow read: if isTdtuUser();
      allow write: if isLecturer() || isOwner(userId);
    }

    // 2. Danh sách sinh viên thực tập (Bảo mật PII & GPA)
    match /tdtu_students/{studentId} {
      allow read: if isLecturer() || (isTdtuUser() && request.auth.token.email.matches('(?i)^' + studentId + '@.*'));
      allow write: if isLecturer();
    }

    // 3. Khai báo nơi thực tập
    match /tdtu_declarations/{declId} {
      allow read: if isTdtuUser();
      allow create, update: if isTdtuUser();
      allow delete: if isLecturer();
    }

    // 4. Chứng chỉ ngoại ngữ
    match /tdtu_certificates/{certId} {
      allow read: if isTdtuUser();
      allow create, update: if isTdtuUser();
      allow delete: if isLecturer();
    }

    // 5. Bảng tin tuyển dụng & Thông báo chung
    match /tdtu_bulletin/{postId} {
      allow read: if isTdtuUser();
      allow write: if isLecturer();
    }

    // 6. Đơn ứng tuyển JD
    match /tdtu_applications/{appId} {
      allow read: if isTdtuUser();
      allow create: if isTdtuUser();
      allow update, delete: if isLecturer();
    }

    // 7. Thông báo học vụ
    match /tdtu_notifications/{notifId} {
      allow read: if isTdtuUser();
      allow write: if isTdtuUser();
    }

    // 8. Cấu hình hệ thống & Học kỳ
    match /tdtu_system/{configDoc} {
      allow read: if isTdtuUser();
      allow write: if isLecturer();
    }

    // Mặc định: Chặn toàn bộ các collection / document không nằm trong danh mục trên
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
