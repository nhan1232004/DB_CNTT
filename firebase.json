{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "TDTU_DB_CNTT_System/frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "src/**/*.ts",
      "src/**/*.tsx",
      "data/**/*.xlsx",
      "package.json",
      "tsconfig.json"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          },
          {
            "key": "Expires",
            "value": "0"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
