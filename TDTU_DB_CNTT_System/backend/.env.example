# ==============================================================================
# TDTU INTERNSHIP PORTAL - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Cổng lắng nghe máy chủ
PORT=3000

# Môi trường chạy (development | production | test)
NODE_ENV=development

# Khóa bí mật ký mã HMAC-SHA256 Token JWT
JWT_SECRET=TDTU_IT_FACULTY_INTERNSHIP_SECRET_2026_KEY_SECURE_HMAC

# Đường dẫn vật lý cơ sở dữ liệu SQLite
DB_PATH=./src/data/db_cntt.sqlite

# Đường dẫn bộ dữ liệu 91 sinh viên mẫu
REAL_STUDENTS_PATH=./src/data/real-students.json
