{
  "name": "dashboard-tsnn-tdtu-monorepo",
  "version": "3.0.0",
  "description": "Hệ thống Quản lý Thực tập & Dashboard TSNN (DB_CNTT) - Khoa CNTT ĐH Tôn Đức Thắng",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "start": "node apps/api/src/main.ts",
    "dev:api": "node --watch apps/api/src/main.ts",
    "test": "node --test apps/api/tests/api.test.ts",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "deploy": "cmd /c deploy-docker.bat"
  },
  "keywords": [
    "tdtu",
    "dashboard-tsnn",
    "internship",
    "adapter-pattern",
    "chart-router",
    "react",
    "nodejs"
  ],
